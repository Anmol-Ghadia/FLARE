      const int i = std::stoi(pStr);
      if ((i < static_cast<int>((std::numeric_limits<T>::min)())) ||
          (i > static_cast<int>((std::numeric_limits<T>::max)()))) {
        throw std::out_of_range("conversion: out of range");
      }
      pVal = static_cast<T>(i);
