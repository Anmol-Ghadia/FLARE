    TIFFGetField(tifr, TIFFTAG_COMPRESSION, &got_comp);
    TIFFGetField(tifr, TIFFTAG_PHOTOMETRIC, &got_photo);

    (void)photometric;
    (void)planar;
    (void)orient;
    (void)sampleformat;
    (void)got_spp;
    (void)got_planar;
    (void)got_orient;
    (void)got_sampleformat;

    TIFFClose(tifr);

    TIFF *tifx = TIFFOpen("./dummy_file", "r");
    if (tifx) {
        TIFFClose(tifx);
    }

    return 0;
}
