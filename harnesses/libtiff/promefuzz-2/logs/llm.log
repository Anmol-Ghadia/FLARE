static uint32_t read_u32(const uint8_t *p, size_t n) {
    uint32_t v = 0;
    size_t i;
    if (n > 4) n = 4;
    for (i = 0; i < n; i++) {
        v = (v << 8) | p[i];
    }
    return v;
}

int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
