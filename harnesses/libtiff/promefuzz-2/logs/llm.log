        (void)TIFFWriteCustomDirectory(tif_rw, &diroff);
        TIFFFreeDirectory(tif_rw);

        if (Size & 1U) {
            (void)TIFFCreateGPSDirectory(tif_rw);
            (void)TIFFWriteCustomDirectory(tif_rw, &diroff);
            TIFFFreeDirectory(tif_rw);
        } else {
