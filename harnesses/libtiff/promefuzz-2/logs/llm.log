void TIFFErrorExt(thandle_t fd, const char* module, const char* fmt, ...) {
  va_list ap;
  if (_TIFFerrorHandler) {
    va_start(ap, fmt);
    (*_TIFFerrorHandler)(module, fmt, ap);
    va_end(ap);
  }
  if (_TIFFerrorHandlerExt) {
    va_start(ap, fmt);
    (*_TIFFerrorHandlerExt)(fd, module, fmt, ap);
    va_end(ap);
  }
}
