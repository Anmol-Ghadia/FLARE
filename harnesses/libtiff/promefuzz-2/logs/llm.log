extern int TIFFIsCODECConfigured(uint16_t);
```

## Source Code

```c
int TIFFIsCODECConfigured(uint16_t scheme) {
  const TIFFCodec* codec = TIFFFindCODEC(scheme);

  if (codec == NULL) {
    return 0;
  }
  if (codec->init == NULL) {
    return 0;
  }
  if (codec->init != NotConfigured) {
    return 1;
  }
  return 0;
}
```

