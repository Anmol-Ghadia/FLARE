    toff_t exif_off = (toff_t)rd32(Data + (Size > 8 ? 8 : 0), Size > 8 ? Size - 8 : 0);
    toff_t custom_read_off = (toff_t)rd32(Data + (Size > 12 ? 12 : 0), Size > 12 ? Size - 12 : 0);

