static uint16_t rd16(const uint8_t **p, size_t *n) {
    uint16_t v = 0;
    if (*n >= 2) {
        v = (uint16_t)((*p)[0] | ((uint16_t)(*p)[1] << 8));
        *p += 2;
        *n -= 2;
    } else if (*n == 1) {
        v = (*p)[0];
        *p += 1;
        *n -= 1;
    }
    return v;
}

static uint32_t rd32(const uint8_t **p, size_t *n) {
    uint32_t v = 0;
    size_t i, m = *n < 4 ? *n : 4;
    for (i = 0; i < m; i++) {
        v |= ((uint32_t)(*p)[i]) << (8 * i);
    }
    *p += m;
    *n -= m;
    return v;
}

static float rdfloat(const uint8_t **p, size_t *n) {
    uint32_t u = rd32(p, n);
    float f;
    memcpy(&f, &u, sizeof(f));
    return f;
}

static double rddouble(const uint8_t **p, size_t *n) {
    uint64_t u = 0;
    size_t i, m = *n < 8 ? *n : 8;
    for (i = 0; i < m; i++) {
        u |= ((uint64_t)(*p)[i]) << (8 * i);
    }
    *p += m;
    *n -= m;
    double d;
    memcpy(&d, &u, sizeof(d));
    return d;
}

