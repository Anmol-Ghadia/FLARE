        TIFFFieldArray infoarray;
        uint64_t diroff = 0;
        uint32_t v0 = 0, v1 = 0;

        init_custom_field(&fields[0], 65000U, "FuzzCustomTag0");
        init_custom_field(&fields[1], 65001U, "FuzzCustomTag1");

