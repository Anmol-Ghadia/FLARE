static uint32_t read_u32(const uint8_t *p) {
    return ((uint32_t)p[0]) |
           ((uint32_t)p[1] << 8) |
           ((uint32_t)p[2] << 16) |
           ((uint32_t)p[3] << 24);
}

static float read_f32(const uint8_t *p) {
    float f = 0.0f;
    memcpy(&f, p, 4);
    return f;
}

int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FILE *fp = fopen("./dummy_file", "wb");
    if (fp != NULL) {
        if (Size > 0) {
            (void)fwrite(Data, 1, Size, fp);
        }
        fclose(fp);
    }

    if (sizeof(float) != 4) {
        return 0;
    }

    uint32_t packed24 = 0;
    uint32_t packed32 = 0;
    int em = 0;
    float xyz1[3] = {0.0f, 0.0f, 0.0f};
    float xyz2[3] = {0.0f, 0.0f, 0.0f};
    float xyz3[3] = {0.0f, 0.0f, 0.0f};
    float arr[8] = {0.0f};
    uint32_t r = 0, g = 0, b = 0;

    if (Size >= 4) {
        packed24 = read_u32(Data);
        packed32 = read_u32(Data);
    } else {
        for (size_t i = 0; i < Size; ++i) {
            packed24 |= ((uint32_t)Data[i]) << (8 * i);
            packed32 |= ((uint32_t)Data[i]) << (8 * i);
        }
    }

    if (Size >= 8) {
        em = (int)(read_u32(Data + 4) & 0x7fffffffU);
    } else if (Size > 4) {
        uint32_t tmp = 0;
        for (size_t i = 4; i < Size; ++i) {
            tmp |= ((uint32_t)Data[i]) << (8 * (i - 4));
        }
        em = (int)(tmp & 0x7fffffffU);
    }

    for (size_t i = 0; i < 8; ++i) {
        size_t off = i * 4;
        if (off + 4 <= Size) {
            arr[i] = read_f32(Data + off);
        } else {
            arr[i] = (float)(i + 1);
        }
