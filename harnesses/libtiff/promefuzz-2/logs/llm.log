            (void)TIFFGetField(tif, TIFFTAG_TILELENGTH, &tile_h);

            if (tile_w == 0) tile_w = 16;
            if (tile_h == 0) tile_h = 16;

            size_t pixels = (size_t)tile_w * (size_t)tile_h;
