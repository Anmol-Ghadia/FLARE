	_TIFFSetupFields(tif, infoarray);

	tif->tif_diroff = 0;
	tif->tif_nextdiroff = 0;
	tif->tif_curoff = 0;
	tif->tif_row = (uint32_t) -1;
	tif->tif_curstrip = (uint32_t) -1;

	return 0;
}
