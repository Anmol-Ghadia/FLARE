  if ((tif->tif_flags & TIFF_DIRTYDIRECT) != 0) {
    TIFFErrorExt(tif->tif_clientdata, module,
                 "Directory has changes other than the strile arrays. "
                 "TIFFRewriteDirectory() should be called instead");
