            unsigned v3 = Data[3];
            TIFFError("fuzz", "vals:%u:%u:%u:%u", v0, v1, v2, v3);
            TIFFWarning("fuzz", "mix:%u-%u", v0, v1);
            TIFFErrorExt((thandle_t)(uintptr_t)v2, "fuzz_ext", "triple:%u:%u:%u", v0, v1, v2);
            TIFFWarningExt((thandle_t)(uintptr_t)v3, "fuzz_warn_ext", "single:%u", v3);
