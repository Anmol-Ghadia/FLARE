    uint16_t bps_choices[] = {1, 2, 4, 8, 16};
    uint16_t bps = bps_choices[rd16(&p, &n) % (sizeof(bps_choices) / sizeof(bps_choices[0]))];
    uint16_t photo = (spp == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;
