        (void)TIFFGetField(tif1, TIFFTAG_ORIENTATION, &u16);
        (void)TIFFGetField(tif1, TIFFTAG_XRESOLUTION, &f);
        (void)TIFFGetField(tif1, TIFFTAG_YRESOLUTION, &f);

        (void)TIFFGetField(tif1, TIFFTAG_GPSIFD, &off);
