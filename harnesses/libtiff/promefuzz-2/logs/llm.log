void TIFFSwabArrayOfTriples(register uint8_t* tp, tmsize_t n) {
  unsigned char* cp;
  unsigned char t;

  /* XXX unroll loop some */
  while (n-- > 0) {
    cp = (unsigned char*)tp;
    t = cp[2];
    cp[2] = cp[0];
    cp[0] = t;
    tp += 3;
  }
}
