static uint64_t read_u64_le(const uint8_t *p, size_t n) {
    uint64_t v = 0;
    size_t i;
    size_t lim = n < 8 ? n : 8;
    for (i = 0; i < lim; i++) {
        v |= ((uint64_t)p[i]) << (8 * i);
    }
    return v;
}

