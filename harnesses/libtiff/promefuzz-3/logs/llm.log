        field = TIFFFieldWithTag(tif, 65100);
        if (field)
            (void)TIFFFieldName(field);

        field = TIFFFindField(tif, 65001, TIFF_LONG);
        if (field)
            (void)TIFFFieldName(field);

        TIFFClose(tif);
    }

