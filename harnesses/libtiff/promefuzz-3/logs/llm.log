        TIFFCodec *registered2 = TIFFRegisterCODEC(scheme2, "altcodec", DummyInit);
        if (registered2 != NULL)
            TIFFUnRegisterCODEC(registered2);
    }

    TIFF *tif = TIFFOpen("./dummy_file", "r");
    if (tif != NULL)
    {
        char emsg[1024];
        memset(emsg, 0, sizeof(emsg));
        (void)TIFFRGBAImageOK(tif, emsg);
        TIFFClose(tif);
    }

    return 0;
}
