static size_t build_minimal_tiff(const uint8_t *Data, size_t Size, uint8_t **out) {
    const uint32_t width = (Size > 0) ? ((uint32_t)Data[0] + 1U) : 1U;
    const uint32_t height = (Size > 1) ? ((uint32_t)Data[1] + 1U) : 1U;
