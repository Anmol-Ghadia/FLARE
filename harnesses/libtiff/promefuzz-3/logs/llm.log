    uint16_t fillorder = (Size >= 16 && (local[14] & 1)) ? FILLORDER_LSB2MSB : FILLORDER_MSB2LSB;
    uint16_t rowsperstrip = (Size >= 20 ? (uint16_t)((rd32(local + 16) % 64U) + 1U) : 1U);
    float xres = (Size >= 24 ? rdfloat(local + 20) : 72.0f);
