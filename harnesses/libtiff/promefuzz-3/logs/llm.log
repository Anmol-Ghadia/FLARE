  if (tile >= td->td_nstrips) {
    TIFFErrorExt(tif->tif_clientdata, module,
                 "%" PRIu32 ": Tile out of range, max %" PRIu32,
                 tile, td->td_nstrips);
    return ((tmsize_t)(-1));
