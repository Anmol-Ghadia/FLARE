TIFFReadRawTile(TIFF* tif, uint32_t tile, void* buf, tmsize_t size) {
  static const char module[] = "TIFFReadRawTile";
  TIFFDirectory* td = &tif->tif_dir;
  uint64_t bytecount64;
  tmsize_t bytecountm;

  if (!TIFFCheckRead(tif, 1))
    return ((tmsize_t)(-1));
  if (tile >= td->td_nstrips) {
