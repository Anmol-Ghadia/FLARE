           ((uint32_t)p[2] << 16) |
           ((uint32_t)p[3] << 24);
}

static float bytes_to_float(const uint8_t *p) {
    uint32_t u = read_u32(p);
    float f;
    memcpy(&f, &u, sizeof(f));
    return f;
}

static double bytes_to_double(const uint8_t *p) {
    uint64_t u = ((uint64_t)p[0]) |
