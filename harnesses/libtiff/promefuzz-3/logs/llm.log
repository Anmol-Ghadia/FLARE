    const uint32_t bits_offset = ifd_offset + ifd_size;
    const uint32_t strip_offset = bits_offset + 2;
    const uint32_t total_size = strip_offset + payload_len;

    uint8_t *buf = (uint8_t *)malloc(total_size);
    uint8_t *p;
    int i;

    if (!buf)
        return 0;

    memset(buf, 0, total_size);

    buf[0] = 'I';
    buf[1] = 'I';
    wr16le(buf + 2, 42);
    wr32le(buf + 4, ifd_offset);

    p = buf + ifd_offset;
    wr16le(p, entry_count);
    p += 2;

