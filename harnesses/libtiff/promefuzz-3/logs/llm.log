    tmsize_t alloc2 = bounded_size(v1, 1 << 16);
    tmsize_t copysz = bounded_size(v2, 1 << 15);
    tmsize_t c_n = bounded_size(v3, 1024);
    tmsize_t c_s = bounded_size(v0 ^ v1, 256);

    void *buf1 = _TIFFmalloc(alloc1);
    void *buf2 = _TIFFcalloc(c_n, c_s);

