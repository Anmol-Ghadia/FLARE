static void *make_sized_copy(const uint8_t *src, size_t src_size, size_t need) {
    uint8_t *buf;
    size_t i;

    if (need == 0) return NULL;
    buf = (uint8_t *)malloc(need);
    if (!buf) return NULL;
    if (src_size == 0) {
        memset(buf, 0, need);
        return buf;
    }
    for (i = 0; i < need; ++i) {
        buf[i] = src[i % src_size];
    }
    return buf;
}

