## Source Code

```c
tmsize_t
TIFFRawStripSize(TIFF* tif, uint32_t strip) {
  static const char module[] = "TIFFRawStripSize";
  uint64_t m;
  tmsize_t n;
  m = TIFFRawStripSize64(tif, strip);
  if (m == (uint64_t)(-1))
    n = (tmsize_t)(-1);
  else {
    n = (tmsize_t)m;
    if ((uint64_t)n != m) {
      TIFFErrorExt(tif->tif_clientdata, module, "Integer overflow");
      n = 0;
    }
  }
  return (n);
}
```

