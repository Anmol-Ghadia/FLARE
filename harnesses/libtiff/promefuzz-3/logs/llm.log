    float f1 = 2 - 2 * LumaRed;
    int32_t D1 = FIX(CLAMP(f1, 0.0F, 2.0F));
    float f2 = LumaRed * f1 / LumaGreen;
    int32_t D2 = -FIX(CLAMP(f2, 0.0F, 2.0F));
    float f3 = 2 - 2 * LumaBlue;
    int32_t D3 = FIX(CLAMP(f3, 0.0F, 2.0F));
