                case 3:
                    (void)TIFFWriteDirectory(tif);
                    break;
                case 4:
                    TIFFFreeDirectory(tif);
                    break;
            }
            (void)TIFFAccessTagMethods(tif);
        }
    } else {
        (void)TIFFWriteDirectory(tif);
        TIFFFreeDirectory(tif);
    }

    TIFFClose(tif);
    return 0;
}
