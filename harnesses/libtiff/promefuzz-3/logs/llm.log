void TIFFSwabLong(uint32_t* lp) {
  register unsigned char* cp = (unsigned char*)lp;
  unsigned char t;
  assert(sizeof(uint32_t) == 4);
  t = cp[3];
  cp[3] = cp[0];
  cp[0] = t;
  t = cp[2];
  cp[2] = cp[1];
  cp[1] = t;
}
```

