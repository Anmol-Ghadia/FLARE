extern void TIFFSwabArrayOfFloat(float* fp, tmsize_t n);
```

## Source Code

```c
void TIFFSwabArrayOfFloat(register float *fp, tmsize_t n) {
  register unsigned char *cp;
  register unsigned char t;
  assert(sizeof(float) == 4);
  /* XXX unroll loop some */
  while (n-- > 0) {
    cp = (unsigned char *)fp;
    t = cp[3];
    cp[3] = cp[0];
    cp[0] = t;
    t = cp[2];
    cp[2] = cp[1];
    cp[1] = t;
    fp++;
  }
}
```

