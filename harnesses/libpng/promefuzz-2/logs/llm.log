    }

    png_set_compression_buffer_size(png_ptr, buf_size);
    (void)png_reset_zstream(png_ptr);

    if (control & 0x01) {
        size_t consumed = 0;
        while (consumed < pngSize) {
            size_t chunk = 1 + (pngData[consumed] % 32);
            if (chunk > pngSize - consumed) {
