#endif

#ifdef PNG_WRITE_FLUSH_SUPPORTED
#ifdef PNG_STDIO_SUPPORTED

  if (output_flush_fn != NULL)
    png_ptr->output_flush_fn = output_flush_fn;

  else
    png_ptr->output_flush_fn = png_default_flush;

#else
   png_ptr->output_flush_fn = output_flush_fn;
// some code omitted...

