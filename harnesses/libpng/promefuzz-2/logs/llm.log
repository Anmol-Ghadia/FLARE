PNG_FP_EXPORT(232, void, png_set_cHRM_XYZ, (png_const_structrp png_ptr,
    png_inforp info_ptr, double red_X, double red_Y, double red_Z,
    double green_X, double green_Y, double green_Z, double blue_X,
    double blue_Y, double blue_Z))
PNG_FIXED_EXPORT(136, void, png_set_cHRM_fixed, (png_const_structrp png_ptr,
    png_inforp info_ptr, png_fixed_point int_white_x,
    png_fixed_point int_white_y, png_fixed_point int_red_x,
    png_fixed_point int_red_y, png_fixed_point int_green_x,
    png_fixed_point int_green_y, png_fixed_point int_blue_x,
    png_fixed_point int_blue_y))
PNG_FIXED_EXPORT(233, void, png_set_cHRM_XYZ_fixed, (png_const_structrp png_ptr,
    png_inforp info_ptr, png_fixed_point int_red_X, png_fixed_point int_red_Y,
    png_fixed_point int_red_Z, png_fixed_point int_green_X,
    png_fixed_point int_green_Y, png_fixed_point int_green_Z,
    png_fixed_point int_blue_X, png_fixed_point int_blue_Y,
    png_fixed_point int_blue_Z))
#endif

#ifdef PNG_eXIf_SUPPORTED
PNG_EXPORT(246, png_uint_32, png_get_eXIf, (png_const_structrp png_ptr,
    png_inforp info_ptr, png_bytep *exif));
    ```
10. `png_progressive_combine_row`
    Used with progressive read callbacks to update `old_row` from libpng’s internal row buffer. `new_row` is only a non-NULL flag; its value is ignored. If `png_ptr` is NULL, it does nothing. If `new_row` is NULL, no combine occurs. Its signature is:
    ```cpp
    /* Function that combines rows.  'new_row' is a flag that should come from
 * the callback and be non-NULL if anything needs to be done; the library
 * stores its own version of the new data internally and ignores the passed
 * in value.
 */
PNG_EXPORT(93, void, png_progressive_combine_row, (png_const_structrp png_ptr,
    png_bytep old_row, png_const_bytep new_row));
    ```
11. `png_set_tRNS`
    `png_set_tRNS` stores tRNS transparency info in `info_ptr` for later PNG writing/reading. Call it with valid `png_ptr`/`info_ptr`; pass either palette alpha bytes (`trans_alpha`, `num_trans`) or a transparent color (`trans_color`). NULL pointers return immediately; invalid/too-large counts are ignored. Its signature is:
    ```cpp
    
PNG_EXPORT(167, void, png_set_tRNS, (png_structrp png_ptr,
    png_inforp info_ptr, png_const_bytep trans_alpha, int num_trans,
    png_const_color_16p trans_color));
    ```
12. `png_set_filter_heuristics_fixed`
    A no-op stub for setting PNG filter heuristic weights/costs. Intended for write-time filter selection tuning, but this build ignores all args and has no effect. Use only if your libpng was built with weighted-filter support. Its signature is:
    ```cpp
    
PNG_FIXED_EXPORT(209, void, png_set_filter_heuristics_fixed,
    (png_structrp png_ptr, int heuristic_method, int num_weights,
    png_const_fixed_point_p filter_weights,
    png_const_fixed_point_p filter_costs))
#endif /* WRITE_WEIGHTED_FILTER */

/* The following are no longer used and will be removed from libpng-1.7: */
#define PNG_FILTER_HEURISTIC_DEFAULT    0  /* Currently "UNWEIGHTED" */
#define PNG_FILTER_HEURISTIC_UNWEIGHTED 1  /* Used by libpng < 0.95 */
#define PNG_FILTER_HEURISTIC_WEIGHTED   2  /* Experimental feature */
#define PNG_FILTER_HEURISTIC_LAST       3  /* Not a valid value */

/* Set the library compression level.  Currently, valid values range from
 * 0 - 9, corresponding directly to the zlib compression levels 0 - 9
 * (0 - no compression, 9 - "maximal" compression).  Note that tests have
 * shown that zlib compression levels 3-6 usually perform as well as level 9
 * for PNG images, and do considerably fewer caclulations.  In the future,
 * these values may not correspond directly to the zlib compression levels.
 */
#ifdef PNG_WRITE_CUSTOMIZE_COMPRESSION_SUPPORTED
PNG_EXPORT(69, void, png_set_compression_level, (png_structrp png_ptr,
    int level));
    ```
13. `png_get_current_pass_number`
    Returns the current interlace pass index from `png_ptr->pass`. Use it only with a valid `png_ptr`; if `png_ptr` is `NULL`, it returns `8` as an invalid sentinel. Its signature is:
    ```cpp
    
PNG_EXPORT(218, png_byte, png_get_current_pass_number, (png_const_structrp));
    ```
14. `png_get_pixels_per_inch`
    Returns the image resolution in pixels/inch, derived from the stored pixels/meter value. Call it with valid `png_ptr` and `info_ptr` after reading metadata. If no pHYs/resolution is present, it returns 0. Its signature is:
    ```cpp
    
PNG_EXPORT(193, png_uint_32, png_get_pixels_per_inch,
    (png_const_structrp png_ptr, png_const_inforp info_ptr));
    ```
15. `png_set_scale_16`
    `png_set_scale_16` requests libpng to accurately scale 16-bit samples down to 8-bit during read. Call it on a valid `png_ptr` before reading rows. If read transforms aren’t allowed (`png_rtran_ok` fails), it does nothing; otherwise it sets `PNG_SCALE_16_TO_8`. Its signature is:
    ```cpp
    /* Scale a 16-bit depth file down to 8-bit, accurately. */
PNG_EXPORT(229, void, png_set_scale_16, (png_structrp png_ptr));
    ```
16. `png_save_int_32`
    `png_save_int_32` stores a signed 32-bit integer into a 4-byte PNG buffer. Use it when writing an `png_int_32` value to bytes; it just casts to `png_uint_32` and calls `png_save_uint_32`, so the raw 32-bit bit pattern is saved. Its signature is:
    ```cpp
    
PNG_EXPORT(206, void, png_save_int_32, (png_bytep buf, png_int_32 i));
    ```
17. `png_convert_from_time_t`
    Converts a `time_t` to `png_time` using `gmtime()` then `png_convert_from_struct_tm()`. Use it to fill a `png_time` from a Unix timestamp. If `gmtime()` fails/returns null, behavior depends on `png_convert_from_struct_tm()` handling. Its signature is:
    ```cpp
    /* Convert from time_t to png_time.  Uses gmtime() */
PNG_EXPORT(25, void, png_convert_from_time_t, (png_timep ptime, time_t ttime));
    ```
18. `png_set_oFFs`
    Sets the PNG oFFs chunk: stores image x/y offsets and unit type in `info_ptr`, marking `PNG_INFO_oFFs` valid. Call with non-NULL `png_ptr`/`info_ptr`; if either is NULL, it returns with no effect. Its signature is:
    ```cpp
    
PNG_EXPORT(146, void, png_set_oFFs, (png_const_structrp png_ptr,
    png_inforp info_ptr, png_int_32 offset_x, png_int_32 offset_y,
    int unit_type));
    ```
19. `png_get_user_width_max`
    Returns the user-set maximum image width from `png_ptr`. Use it to query the limit previously configured in the PNG read/write struct. If `png_ptr` is `NULL`, it returns `0`. Its signature is:
    ```cpp
    
PNG_EXPORT(187, png_uint_32, png_get_user_width_max,
    (png_const_structrp png_ptr));
    ```
20. `png_get_sCAL_s`
    `png_get_sCAL_s` reads the sCAL chunk from `info_ptr`. Use it after `png_read_info`; it fills `unit`, `width`, and `height` with the stored strings. Returns `PNG_INFO_sCAL` if present, else 0. It does not allocate or copy data. Its signature is:
    ```cpp
    
PNG_EXPORT(169, png_uint_32, png_get_sCAL_s,
    (png_const_structrp png_ptr, png_const_inforp info_ptr, int *unit,
    png_charpp swidth, png_charpp sheight));
    ```
21. `png_get_sCAL`
    `png_get_sCAL` retrieves the sCAL chunk from `info_ptr`: it returns `PNG_INFO_sCAL` if present, fills `unit`, `width`, and `height` by converting stored strings to `double`, else returns 0. Use only when floating-point support is available. Its signature is:
    ```cpp
    
PNG_FP_EXPORT(168, png_uint_32, png_get_sCAL, (png_const_structrp png_ptr,
    png_const_inforp info_ptr, int *unit, double *width, double *height))
#if defined(PNG_FLOATING_ARITHMETIC_SUPPORTED) || \
   defined(PNG_FLOATING_POINT_SUPPORTED)
/* NOTE: this API is currently implemented using floating point arithmetic,
 * consequently it can only be used on systems with floating point support.
 * In any case the range of values supported by png_fixed_point is small and it
 * is highly recommended that png_get_sCAL_s be used instead.
 */
PNG_FIXED_EXPORT(214, png_uint_32, png_get_sCAL_fixed,
    (png_const_structrp png_ptr, png_const_inforp info_ptr, int *unit,
    png_fixed_point *width, png_fixed_point *height))
#endif
PNG_EXPORT(169, png_uint_32, png_get_sCAL_s,
    (png_const_structrp png_ptr, png_const_inforp info_ptr, int *unit,
    png_charpp swidth, png_charpp sheight));
    ```
22. `png_image_finish_read`
    `png_image_finish_read` completes a png_image read into `buffer`, using `background`/`colormap` if needed. It validates `image` version and checks `row_stride` for signed-32-bit overflow; `row_stride==0` means use the natural row size. Returns failure on invalid args/overflow. Its signature is:
    ```cpp
    
PNG_EXPORT(237, int, png_image_finish_read, (png_imagep image,
   png_const_colorp background, void *buffer, png_int_32 row_stride,
   void *colormap));
    ```
23. `png_get_bKGD`
    `png_get_bKGD` retrieves the image’s stored bKGD chunk. Call it with valid `png_ptr`, `info_ptr`, and a non-NULL `background` pointer. If `PNG_INFO_bKGD` is set, it returns that flag and gives you `info_ptr->background`; otherwise it returns 0. Its signature is:
    ```cpp
    
PNG_EXPORT(131, png_uint_32, png_get_bKGD, (png_const_structrp png_ptr,
    png_inforp info_ptr, png_color_16p *background));
    ```
24. `png_set_swap`
    `png_set_swap` enables byte-swapping for 16-bit PNG data. Call it on a valid `png_ptr`; if `bit_depth == 16`, it sets `PNG_SWAP_BYTES`. If `png_ptr` is NULL or depth isn’t 16, it does nothing. Its signature is:
    ```cpp
    /* Swap bytes in 16-bit depth files. */
PNG_EXPORT(41, void, png_set_swap, (png_structrp png_ptr));
    ```


