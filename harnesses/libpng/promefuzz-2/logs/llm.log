  png_write_end(png_ptr, info_ptr);

  png_uint_32 masks[] = {
      PNG_FREE_TEXT,
#ifdef PNG_FREE_EXIF
      PNG_FREE_EXIF,
#endif
      PNG_FREE_ALL
  };

  for (size_t i = 0; i < sizeof(masks) / sizeof(masks[0]); ++i) {
    png_free_data(png_ptr, info_ptr, masks[i], -1);
    png_free_data(png_ptr, info_ptr, masks[i], 0);
