static png_uint_32 ReadU32(const uint8_t* data, size_t size, size_t& off) {
  png_uint_32 v = 0;
  for (int i = 0; i < 4; ++i) {
    v <<= 8;
    if (off < size) v |= data[off++];
  }
  return v;
}

static uint8_t NextByte(const uint8_t* data, size_t size, size_t& off, uint8_t fallback) {
  if (off < size) return data[off++];
