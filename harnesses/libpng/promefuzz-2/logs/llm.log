      png_write_png(png_ptr, info_ptr, transforms, NULL);
    }
  } else {
    png_write_info_before_PLTE(png_ptr, info_ptr);
  }

  png_write_end(png_ptr, info_ptr);

  FreeRows(rows, height);
  png_destroy_write_struct(&png_ptr, &info_ptr);
  fclose(fp);
  return 0;
}
