    png_destroy_write_struct(&png_ptr, &info_ptr);
    remove("./dummy_file");
    return 0;
  }

  FILE* fp = fopen("./dummy_file", "wb");
  if (fp == NULL) {
    png_destroy_write_struct(&png_ptr, &info_ptr);
    return 0;
  }

  png_set_write_fn(png_ptr, fp, PngWriteFn, PngFlushFn);

  int width = 1 + (Size > 4 ? (Data[4] % 8) : 0);
  int height = 1 + (Size > 5 ? (Data[5] % 8) : 0);
