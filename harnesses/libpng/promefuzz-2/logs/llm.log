PNG_FIXED_EXPORT(140, void, png_set_gAMA_fixed, (png_const_structrp png_ptr,
    png_inforp info_ptr, png_fixed_point int_file_gamma))
#endif

#ifdef PNG_hIST_SUPPORTED
PNG_EXPORT(141, png_uint_32, png_get_hIST, (png_const_structrp png_ptr,
    png_inforp info_ptr, png_uint_16p *hist));
    ```
20. `png_read_png`
    `png_read_png()` is a convenience “read whole image” API: it calls `png_read_info()`, applies requested transforms, then reads the image data. Use it only after setting up `png_ptr/info_ptr` and desired transform flags. If `png_ptr`/`info_ptr` is NULL it returns; oversized height triggers `png_error()`. Its signature is:
    ```cpp
    
PNG_EXPORT(178, void, png_read_png, (png_structrp png_ptr, png_inforp info_ptr,
    int transforms, png_voidp params));
