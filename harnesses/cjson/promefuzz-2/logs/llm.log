CJSON_PUBLIC(double)
cJSON_SetNumberHelper(cJSON *object, double number) {
  if (object == NULL) {
    return (double)NAN;
  }

  if (number >= INT_MAX) {
    object->valueint = INT_MAX;
  } else if (number <= (double)INT_MIN) {
    object->valueint = INT_MIN;
  } else {
    object->valueint = (int)number;
  }

  return object->valuedouble = number;
}
