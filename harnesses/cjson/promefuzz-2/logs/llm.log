static char *make_string_from_data(const uint8_t *Data, size_t Size, size_t offset, size_t len) {
    char *s = (char *)malloc(len + 1);
    if (s == NULL) {
        return NULL;
    }
    if (offset < Size && len > 0) {
        size_t available = Size - offset;
        if (len > available) {
            len = available;
