        (void)initial_size;

        for (int iter = 0; iter < 16 && remaining > 0; ++iter) {
            int op = (int)(*p++ % 6);
            remaining--;

            int idx = 0;
            if (remaining > 0) {
                idx = read_int(&p, &remaining);
            }

            switch (op) {
                case 0: {
                    cJSON *item = cJSON_GetArrayItem(array, idx);
                    (void)cJSON_IsObject(item);
