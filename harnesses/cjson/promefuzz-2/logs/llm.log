    cJSON *str0 = NULL;
    cJSON *array = NULL;
    cJSON *str1 = NULL;
    cJSON *str2 = NULL;
    cJSON *str3 = NULL;
    cJSON_Hooks hooks;

    if (Size >= 3) {
