CJSON_PUBLIC(cJSON *)
cJSON_CreateStringReference(const char *string) {
  cJSON *item = cJSON_New_Item(&global_hooks);
  if (item != NULL) {
    item->type = cJSON_String | cJSON_IsReference;
    item->valuestring = (char *)cast_away_const(string);
  }

  return item;
}
```

