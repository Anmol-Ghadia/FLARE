            cJSON_free(s2);
        }

        char stackbuf[256];
        (void)cJSON_PrintPreallocated(dup_deep, stackbuf, (int)sizeof(stackbuf), 1);
    }

    cJSON_Delete(dup_shallow);
    cJSON_Delete(dup_deep);
    cJSON_Delete(root);

