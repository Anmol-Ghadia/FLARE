}

static char *dup_from_input(const uint8_t **data, size_t *size) {
    if (*size == 0) {
        return NULL;
    }

    size_t max_len = *size - 1;
    size_t len = (*data)[0] % (max_len + 1);
    char *s = (char *)malloc(len + 1);
    if (s == NULL) {
        return NULL;
