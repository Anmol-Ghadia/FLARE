static double read_double_from_bytes(const uint8_t *data, size_t size, size_t offset) {
    union {
        uint64_t u64;
        double d;
    } conv;
    conv.u64 = 0;

    for (size_t i = 0; i < 8 && (offset + i) < size; ++i) {
        conv.u64 |= ((uint64_t)data[offset + i]) << (8 * i);
    }

    return conv.d;
}

