static double read_double_from_data(const uint8_t *Data, size_t Size, size_t offset) {
    double value = 0.0;
    size_t copy_size = 0;

    if (offset < Size) {
        copy_size = Size - offset;
        if (copy_size > sizeof(value)) {
            copy_size = sizeof(value);
        }
        memcpy(&value, Data + offset, copy_size);
    }

    return value;
}

