    if (len > 0) {
        memcpy(s, *data + 1, len);
    }
    s[len] = '\0';

    *data += 1 + len;
    *size -= 1 + len;
    return s;
}

static cJSON *make_manual_item(const uint8_t **data, size_t *size) {
