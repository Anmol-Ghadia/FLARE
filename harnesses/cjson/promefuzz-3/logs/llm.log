    }

    parse_end = NULL;
    root = cJSON_ParseWithOpts(buf, &parse_end, 0);
    exercise_tree(root, Data, Size);
    if (root != NULL) {
        cJSON_Delete(root);
    }

    parse_end = NULL;
    root = cJSON_ParseWithOpts(buf, &parse_end, 1);
    exercise_tree(root, Data, Size);
    if (root != NULL) {
        cJSON_Delete(root);
    }

    root = cJSON_ParseWithLength(buf, Size);
    exercise_tree(root, Data, Size);
    if (root != NULL) {
        cJSON_Delete(root);
    }

    parse_end = NULL;
    root = cJSON_ParseWithLengthOpts(buf, Size, &parse_end, 0);
