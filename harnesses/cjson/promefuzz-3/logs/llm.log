static int consume_u8(const uint8_t **data, size_t *size)
{
    if (*size == 0) {
        return 0;
    }
    int v = **data;
    (*data)++;
    (*size)--;
    return v;
}

static size_t consume_size(const uint8_t **data, size_t *size)
{
    size_t v = 0;
    size_t n = (*size < sizeof(size_t)) ? *size : sizeof(size_t);
    for (size_t i = 0; i < n; i++) {
        v = (v << 8) | **data;
        (*data)++;
        (*size)--;
    }
    return v;
}

