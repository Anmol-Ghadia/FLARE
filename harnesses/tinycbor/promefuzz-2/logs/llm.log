    FuzzReaderToken *t = (FuzzReaderToken *)token;
    if (!t || !userptr || t->pos > t->size || offset > (t->size - t->pos) || len > (t->size - t->pos - offset))
        return CborErrorIO;
    *userptr = t->data + t->pos + offset;
    return CborNoError;
}

