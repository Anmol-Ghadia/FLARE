        return dst;
    }
    return (void *)src;
}

static void fuzz_advance_bytes(void *token, size_t len) {
    FuzzReaderToken *t = (FuzzReaderToken *)token;
    if (!t)
        return;
    if (len > t->size - t->pos)
        t->pos = t->size;
    else
        t->pos += len;
}

