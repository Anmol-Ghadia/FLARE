        fclose(fp);
    }

    CborParser parser;
    memset(&parser, 0, sizeof(parser));
    parser.source.end = Data + Size;
    parser.flags = 0;

    CborValue value;
    memset(&value, 0, sizeof(value));
    value.parser = &parser;
    value.source.ptr = Data;
    value.remaining = (uint32_t)Size;
