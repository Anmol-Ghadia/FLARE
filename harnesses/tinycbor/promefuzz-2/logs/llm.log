            } else {
                value.extra = 0;
                value.remaining = 0;
            }

            if (cbor_value_is_double(&value)) {
                err = cbor_value_get_double(&value, &d_res);
                (void)err;
            }
        } else {
            value.type = CborBooleanType;
            value.extra = (Size >= 2) ? (uint16_t)(Data[1] & 1u) : 0;
            err = cbor_value_get_boolean(&value, &b_res);
            (void)err;
