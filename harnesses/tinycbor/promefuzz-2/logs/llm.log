static CborError dummy_writer(void *token, const void *data, size_t len, int flags)
{
    (void)flags;
    uint8_t *buf = (uint8_t *)token;
    if (buf && data && len) {
        size_t copy = len > 4096 ? 4096 : len;
        memcpy(buf, data, copy);
    }
    return CborNoError;
}

static size_t take_size(const uint8_t **p, size_t *n)
{
    size_t v = 0;
    size_t count = *n < sizeof(size_t) ? *n : sizeof(size_t);
    for (size_t i = 0; i < count; ++i) {
        v = (v << 8) ^ (*p)[i];
    }
    *p += count;
    *n -= count;
    return v;
}

