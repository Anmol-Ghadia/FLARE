                if (cbor_value_advance(&rec) != CborNoError)
                    break;
            }
            (void)cbor_value_leave_container(&it, &rec);
        }
    }

    {
        CborValue walk = it;
        fuzz_one_value(&walk);
        (void)cbor_value_advance(&walk);
        fuzz_one_value(&walk);
    }

    return 0;
}
