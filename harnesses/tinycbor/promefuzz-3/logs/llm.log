    }
}

static void exercise_map_value(const CborValue *value, const uint8_t *Data, size_t Size) {
    CborValue found;

    if (!has_min_bytes(value, 1))
        return;

    (void)cbor_value_map_find_value(value, "", &found);
    (void)cbor_value_map_find_value(value, "a", &found);

