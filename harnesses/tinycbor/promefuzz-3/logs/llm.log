        (void)cbor_value_reparse(&chunk);

        err = cbor_value_advance(&chunk);
        if (err != CborNoError)
            break;

        if (cbor_value_string_iteration_at_end(&chunk)) {
            (void)cbor_value_finish_string_iteration(&chunk);
            *it = chunk;
            return;
