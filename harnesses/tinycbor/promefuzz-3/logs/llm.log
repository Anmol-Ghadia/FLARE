        CborEncoder parent;
        CborEncoder child;
        cbor_encoder_init_writer(&parent, fuzz_writer, fp);

        size_t map_len = (Size > 0) ? (Data[0] % 3) : 0;
        CborError err = cbor_encoder_create_map(&parent, &child, map_len);
