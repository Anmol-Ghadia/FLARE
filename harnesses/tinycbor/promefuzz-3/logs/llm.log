static void walk_value(const CborValue *it, int depth) {
    if (!it || !cbor_value_is_valid(it) || depth > 32)
        return;

    if (cbor_value_is_byte_string(it)) {
        CborValue tmp = *it;
        consume_byte_string_apis(&tmp);
