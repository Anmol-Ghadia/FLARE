}

static void exercise_value(CborValue *it) {
    if (!value_seems_usable(it))
        return;

    for (int steps = 0; steps < 32; ++steps) {
        if (!value_seems_usable(it))
            break;
        if (cbor_value_at_end(it))
            break;

        CborType t = cbor_value_get_type(it);
        if (t == CborInvalidType)
            break;

