    if (bufsize > 4096)
        bufsize = 4096;

    buf = (uint8_t *)malloc(bufsize ? bufsize : 1);
    if (!buf)
        return 0;

    flags = (off < Size) ? (int)(Data[off++] & 0x0f) : 0;
    cbor_encoder_init(&root, buf, bufsize, flags);

    while (off < Size) {
        uint8_t op = Data[off++] % 8;

        if (op == 0) {
            size_t len = (size_t)((off < Size) ? Data[off++] : 0);
            if (len > Size - off)
