    if (cbor_value_is_array(it)) {
        CborValue rec;
        CborValue parent = *it;
        if (cbor_value_enter_container(&parent, &rec) == CborNoError) {
            int count = 0;
            while (!cbor_value_at_end(&rec) && count++ < 64) {
                walk_value(&rec, depth + 1);
                if (cbor_value_advance(&rec) != CborNoError)
