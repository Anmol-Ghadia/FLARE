                (void)cbor_value_reparse(&tmp);
                if (!cbor_value_is_valid(&tmp))
                    break;
                (void)cbor_value_skip_tag(&tmp);
                if (!cbor_value_is_valid(&tmp))
                    break;
                err = cbor_value_advance(&tmp);
                if (err != CborNoError)
                    break;
            }
        }
    }

    return 0;
}
