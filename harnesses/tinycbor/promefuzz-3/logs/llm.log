                break;
            if (cbor_value_at_end(&rec)) {
                rec_at_end = 1;
                break;
            }

            err = cbor_value_advance(&rec);
            if (err != CborNoError)
                break;

            if (!is_probably_valid_value(&rec))
                break;
            if (cbor_value_at_end(&rec)) {
                rec_at_end = 1;
                break;
