 *
 * This may be NULL, although if this is a directory
 * (@ref LHA_COMPRESS_TYPE_DIR), it is never NULL.
 */
 char *path;

 /**
 * File name.
 *
 * This is never NULL, except if this is a directory
 * (@ref LHA_COMPRESS_TYPE_DIR), where it is always NULL.
 */
