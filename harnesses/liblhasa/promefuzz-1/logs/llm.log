        (void) lha_decoder_get_crc(decoder);
        (void) lha_decoder_get_length(decoder);

        if ((i % 3) == 0) {
            lha_decoder_monitor(decoder, progress_cb, &ctx);
        }
    }

    free(heap_buf);
    lha_decoder_free(decoder);
    return 0;
