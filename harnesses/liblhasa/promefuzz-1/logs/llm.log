    (void) lha_decoder_get_length(decoder);

    heap_buf = (uint8_t *) malloc(1024);
    if (heap_buf == NULL) {
        lha_decoder_free(decoder);
        return 0;
    }

    iterations = 1;
    if (offset < Size) {
        iterations = (Size - offset) < 64 ? (Size - offset) : 64;
    }

    for (i = 0; i < iterations; i++) {
