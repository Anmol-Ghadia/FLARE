        } else {
            req = i;
        }

        switch (req % 4) {
            case 0:
                req = 0;
                got = lha_decoder_read(decoder, stack_buf, req);
                break;
            case 1:
                req = (req % sizeof(stack_buf)) + 1;
                got = lha_decoder_read(decoder, stack_buf, req);
                break;
            case 2:
                req = (req % 1024) + 1;
                got = lha_decoder_read(decoder, heap_buf, req);
                break;
            default:
                req = dtype.max_read + (req % 32);
                if (req > 1024) {
