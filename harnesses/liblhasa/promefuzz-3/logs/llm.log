    (void) buf;
    return 0;
}

static size_t dummy_read_pattern(void *extra_data, uint8_t *buf)
{
    FuzzStream *s = (FuzzStream *) extra_data;
    size_t i, n;

    if (buf == NULL) {
        return 0;
    }

    n = 16;
    if (s != NULL && s->size > 0) {
