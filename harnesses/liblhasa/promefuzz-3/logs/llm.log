#ifdef LHA_READER_DIR_PLAIN
        policies[npolicies++] = LHA_READER_DIR_PLAIN;
#endif
#ifdef LHA_READER_DIR_END_OF_DIR
        policies[npolicies++] = LHA_READER_DIR_END_OF_DIR;
