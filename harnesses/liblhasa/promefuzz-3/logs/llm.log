 */
 uint64_t win_modification_time;

 /**
 * Windows FILETIME file access time, set if
 * @ref LHA_FILE_WINDOWS_TIMESTAMPS is set.
 */
 uint64_t win_access_time;

 /** Length of the compressed data. */
