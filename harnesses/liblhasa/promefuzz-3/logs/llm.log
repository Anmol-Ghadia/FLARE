 /** CRC-16 checksum of the compressed data. */
 uint16_t crc;

 /** Unix timestamp of the modification time of the file. */
 unsigned int timestamp;

 /** Pointer to a buffer containing the raw header data. */
 uint8_t *raw_data;

 /** Length of the raw header data. */
