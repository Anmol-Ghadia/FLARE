                ((unsigned int) Data[2] << 16) ^
                ((unsigned int) Data[3] << 8) ^
                (unsigned int) Data[4];
            decoder->last_block =
                ((unsigned int) Data[5] << 8) ^
                (unsigned int) Data[6];
            decoder->total_blocks =
                ((unsigned int) Data[7] << 8) ^
