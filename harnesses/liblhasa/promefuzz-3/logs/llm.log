                lha_reader_free(reader2);
                reader2 = NULL;
            }
            lha_input_stream_free(stream2);
            stream2 = NULL;
        }
        fclose(fp);
        fp = NULL;
    }

    if (Size >= 1) {
        fp = fopen("./dummy_file", "rb");
        if (fp != NULL) {
            stream3 = lha_input_stream_new(&lha_input_stream_type_FILE, fp);
            if (stream3 != NULL) {
                lha_input_stream_free(stream3);
                stream3 = NULL;
            }
            fclose(fp);
            fp = NULL;
        }
    }

    remove("./dummy_file");
    return 0;
}
