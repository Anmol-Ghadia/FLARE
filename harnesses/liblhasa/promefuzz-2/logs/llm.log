#include "lha_decoder.h"

typedef struct {
    const uint8_t *data;
    size_t size;
    size_t pos;
} InputState;

typedef struct {
    InputState *input;
    uint32_t mode;
    uint32_t state;
    size_t produced;
    size_t limit;
} DummyExtra;

static size_t fuzz_input_callback(void *callback_data, uint8_t *buf, size_t buf_len)
{
    InputState *in = (InputState *) callback_data;
    size_t remain, n;

    if (in == NULL || buf == NULL) {
        return 0;
    }

    if (in->pos >= in->size) {
        return 0;
